# APIキーはすべてサーバー側でのみ読む。NEXT_PUBLIC_ を付けない（設計仕様書 NFR-05）
#
# キーがあるものを上から順に使い、失敗したら次に落ちる（lib/llm.ts）。
# 本番は学校配布のプロキシ1本で動いているため、その停止・失効に備えて
# 独立した事業者のキーを1つ持っておくと機能停止を避けられる。

# Anthropic Claude
# 取得: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# 学校配布の Azure OpenAI 互換プロキシ
AZURE_PROXY_KEY=
AZURE_PROXY_ENDPOINT=
AZURE_PROXY_API_VERSION=2025-04-01-preview

# Google Gemini（フォールバック用）
# 取得: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# 既定は抽出 gemini-3.8-flash / 判定 gemini-2.5-pro。判定は品質優先で下げない
GEMINI_MODEL_EXTRACT=
GEMINI_MODEL_JUDGE=

# AIを呼ばずに固定レスポンスを返す（デモ撮影・UI確認用）
OVERLAI_MOCK=
